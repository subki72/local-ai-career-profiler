# CV Nexus runs 100% locally for maximum data privacy.
# No external LLM API keys are required.
# Copy this file to .env and customize for your local or Docker environment.

# Comma-separated explicit CORS origins (wildcard '*' is disallowed)
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Maximum uploaded PDF size in megabytes (1-100)
MAX_UPLOAD_SIZE_MB=10

# Temporary directory for sanitized CV uploads
UPLOAD_DIR=data/processed

# Local Ollama inference server URL and model name
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Local embedding model and persistent ChromaDB storage directory
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DB_DIR=data/chroma_db

# Backend URL and timeout (seconds) used by the Streamlit UI
API_BASE_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=120

# Logging severity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
